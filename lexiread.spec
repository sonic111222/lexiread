# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the portable Windows build."""
from PyInstaller.utils.hooks import collect_submodules

hiddenimports = collect_submodules("backend")

a = Analysis(
    ["app.py"],
    pathex=[],
    binaries=[],
    datas=[
        ("static", "static"),
        ("tools", "tools"),
        ("backend/data", "backend/data"),
    ],
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        "tkinter",
        "matplotlib",
        "matplotlib_inline",
        "pandas",
        "scipy",
        "numpy",
        "IPython",
        "jupyter",
        "notebook",
        "sphinx",
        "docutils",
        "pytest",
        "_pytest",
        "pygments",
        "setuptools",
        "pkg_resources",
        "lxml",
        "zmq",
        "PyQt5",
        "paramiko",
        "cryptography",
        "nacl",
        "psutil",
        "black",
        "yapf",
        "nbformat",
        "jsonschema",
        "dateutil",
        "babel",
        "pytz",
        "cloudpickle",
        "traitlets",
        "jedi",
        "parso",
        "twisted",
        "pip",
    ],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="LexiRead",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon="assets/lexiread.ico",
)
